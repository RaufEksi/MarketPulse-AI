# ==============================================================================
# MARKETPULSE AI - Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in with your actual values
# NEVER commit .env with real credentials!

# ============== ENVIRONMENT ==================
ENV=development  # development, staging, production
PYTHON_ENV=development

# ============== ALPACA MARKETS API ===========
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets  # paper or live

# ============== REDDIT (PRAW) ================
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_secret
REDDIT_USER_AGENT=MarketPulseAI/1.0

# ============== KAGGLE ======================
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# ============== LOGGING ====================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_DIR=logs/
LOG_FILE=marketpulse.log

# ============== DATA PATHS =================
DATA_DIR=data/
RAW_DATA_DIR=data/raw/
PROCESSED_DATA_DIR=data/processed/
CACHE_DIR=data/cache/
MODEL_DIR=src/models/weights/

# ============== FEATURE ENGINEERING ========
ATR_PERIOD=14
SPIKE_THRESHOLD=0.15  # 15% ATR increase
DECAY_LAMBDA=0.5  # exponential decay rate (per hour)
BATCH_SIZE_EMBEDDING=32
BATCH_SIZE_TRAINING=32

# ============== MODEL TRAINING =============
LEARNING_RATE=0.001
WEIGHT_DECAY=1e-5
NUM_EPOCHS=50
EARLY_STOPPING_PATIENCE=15
VALIDATION_SPLIT=0.2
TEST_SPLIT=0.2

# ============== API (FastAPI) ==============
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true  # auto-reload on code changes (dev only)
API_KEY=your_secret_api_key_here
RATE_LIMIT_PER_MINUTE=100

# ============== DASHBOARD (Streamlit) ======
STREAMLIT_PORT=8501
STREAMLIT_THEME=dark

# ============== DATABASE ===================
DATABASE_URL=sqlite:///data/marketpulse.db  # local SQLite, or postgresql://user:pass@host/db

# ============== REDIS (Caching) ============
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ============== GPU/DEVICE =================
DEVICE=cpu  # cpu or cuda
CUDA_DEVICE_ORDER=PCI_BUS_ID
CUDA_VISIBLE_DEVICES=0

# ============== MONITORING ==================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
